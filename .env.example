# ── DonatePlatform ───────────────────────────────────────────
# Скопировать в .env и заполнить свои значения.
# Для production ОБЯЗАТЕЛЬНО: NODE_ENV=production,
# JWT_SECRET, COOKIE_SECRET
#
# ВСЕ настройки платформы (URL, домены, платёжные шлюзы,
# SMTP, уведомления) теперь редактируются через админку:
# /admin/settings. В .env остаются только секреты и инфра.

# ── Режим ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
UPLOADS_DIR=/home/donate/uploads

# ── MySQL (MariaDB) ─────────────────────────────────────────
DATABASE_URL="mysql://donate:password@localhost:3306/donate_platform"

# ── JWT + Cookies ───────────────────────────────────────────
JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-in-production

# ── Payment Webhook ─────────────────────────────────────────
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# ── Payment Keys Encryption ────────────────────────────────
# AES-256-GCM ключ (64 hex символа)
PAYMENT_KEYS_ENCRYPTION_KEY=

# ── Sentry ──────────────────────────────────────────────────
SENTRY_DSN=

# ── Email (SMTP) ───────────────────────────────────────────
EMAIL_HOST=smtp.bz
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@example.com
