{
  "name": "donate-platform",
  "private": true,
  "scripts": {
    "dev": "pnpm run --parallel -r dev",
    "dev:api": "pnpm --filter @donate/api dev",
    "dev:web": "pnpm --filter @donate/web dev",
    "build": "pnpm run --parallel -r build",
    "build:api": "pnpm --filter @donate/api build",
    "build:web": "pnpm --filter @donate/web build",
    "start": "pnpm --filter @donate/api start & node packages/web/.output/server/index.mjs",
    "db:push": "pnpm --filter @donate/api db:push",
    "db:generate": "pnpm --filter @donate/api db:generate",
    "db:studio": "pnpm --filter @donate/api db:studio",
    "lint": "pnpm run --parallel -r lint",
    "lint:eslint": "eslint packages/",
    "format": "prettier --write packages/",
    "format:check": "prettier --check packages/",
    "test": "vitest run",
    "test:watch": "vitest",
    "make:admin": "pnpm --filter @donate/api make:admin",
    "seed:demo": "pnpm --filter @donate/api seed:demo",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.60.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6"
  }
}
